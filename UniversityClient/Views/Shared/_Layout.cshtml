<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — University Client</title>
    <style>
        body { font-family: Segoe UI, Arial, sans-serif; margin: 0; background: #f5f6fa; color: #222; }
        header { background: #1f3a5f; color: #fff; padding: 12px 24px; }
        header a { color: #ffd479; margin-right: 18px; text-decoration: none; font-weight: 600; }
        main { max-width: 960px; margin: 24px auto; padding: 0 16px; }
        table { border-collapse: collapse; width: 100%; background: #fff; }
        th, td { border: 1px solid #d0d4de; padding: 8px 10px; text-align: left; }
        th { background: #e4e9f4; }
        .error { background: #fdecea; border: 1px solid #f5b5ae; color: #8a1c10; padding: 12px 16px; border-radius: 6px; }
        .ok { background: #e8f6ec; border: 1px solid #a8d8b5; color: #14532d; padding: 12px 16px; border-radius: 6px; }
        .card { background: #fff; border: 1px solid #d0d4de; border-radius: 8px; padding: 16px 20px; }
        .muted { color: #666; }
        pre { background: #1e1e1e; color: #ddd; padding: 12px; border-radius: 6px; overflow: auto; }
        button { padding: 8px 14px; cursor: pointer; }
    </style>
</head>
<body>
<header>
    <a asp-controller="Courses" asp-action="Index">Курстар</a>
    <a asp-controller="Courses" asp-action="CorsDemo">CORS демо</a>
</header>
<main>
    @RenderBody()
</main>
</body>
</html>
